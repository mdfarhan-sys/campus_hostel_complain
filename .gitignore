# ==============================================
# CampusFix Repository .gitignore
# ==============================================

# --- Node Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js

# --- Environment & Sensitive Credentials ---
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
# Keep .env.example tracked for reference
!*.env.example
!.env.example

# --- Production & Build Outputs ---
dist/
*/dist/
dist-ssr/
build/
out/
.next/

# --- User Uploads & Media Storage ---
uploads/
*/uploads/*
!*/uploads/.gitkeep

# --- Runtime Logs & Debug Files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Cache & Testing ---
.cache/
.parcel-cache/
.eslintcache
.turbo/
coverage/
*.lcov
.nyc_output/

# --- macOS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# --- Windows System Files ---
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# --- IDEs & Code Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# --- Gemini / Antigravity Temp ---
.gemini/
